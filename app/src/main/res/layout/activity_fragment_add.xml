<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/greyview"
    tools:context="com.ringstechnology.subscribed.FragmentAdd">

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Select Category"
        android:textColor="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3"
        app:layout_constraintVertical_bias="0.0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/media"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/greenview"
                android:src="@drawable/ic_media_streaming_24dp"
                app:layout_constraintBottom_toTopOf="@+id/gaming"
                app:layout_constraintEnd_toStartOf="@+id/food"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/ic_media_streaming_24dp" />


            <ImageButton
                android:id="@+id/food"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:background="@drawable/greenview"
                android:src="@drawable/ic_food_24dp"
                app:layout_constraintEnd_toStartOf="@+id/self"
                app:layout_constraintStart_toEndOf="@+id/media"
                app:layout_constraintTop_toTopOf="@+id/media"
                tools:src="@drawable/ic_food_24dp" />

            <ImageButton
                android:id="@+id/self"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:background="@drawable/greenview"
                android:src="@drawable/ic_fashion_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/food"
                app:layout_constraintTop_toTopOf="@+id/food"
                tools:src="@drawable/ic_fashion_24" />

            <ImageButton
                android:id="@+id/gaming"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/greenview"
                android:src="@drawable/ic_gaming_24dp"
                app:layout_constraintBottom_toTopOf="@+id/shopping"
                app:layout_constraintStart_toStartOf="@+id/media"
                app:layout_constraintTop_toBottomOf="@+id/media"
                tools:src="@drawable/ic_gaming_24dp" />

            <ImageButton
                android:id="@+id/shopping"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/greenview"
                android:src="@drawable/ic_shopping_24dp"
                app:layout_constraintBottom_toTopOf="@+id/home"
                app:layout_constraintStart_toStartOf="@+id/gaming"
                app:layout_constraintTop_toBottomOf="@+id/gaming"
                tools:src="@drawable/ic_shopping_24dp" />

            <ImageButton
                android:id="@+id/grooming"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:background="@drawable/greenview"
                android:src="@drawable/ic_grooming_24dp"
                app:layout_constraintStart_toStartOf="@+id/books"
                app:layout_constraintTop_toTopOf="@+id/shopping"
                tools:src="@drawable/ic_grooming_24dp" />

            <ImageButton
                android:id="@+id/child"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:background="@drawable/greenview"
                android:src="@drawable/ic_child_care_24dp"
                app:layout_constraintStart_toStartOf="@+id/animal"
                app:layout_constraintTop_toTopOf="@+id/eye"
                tools:src="@drawable/ic_child_care_24dp" />

            <ImageButton
                android:id="@+id/books"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:background="@drawable/greenview"
                android:src="@drawable/ic_book_24dp"
                app:layout_constraintStart_toStartOf="@+id/food"
                app:layout_constraintTop_toTopOf="@+id/gaming"
                tools:src="@drawable/ic_book_24dp" />

            <ImageButton
                android:id="@+id/animal"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:background="@drawable/greenview"
                android:src="@drawable/ic_animal_care_24dp"
                app:layout_constraintStart_toStartOf="@+id/books"
                app:layout_constraintTop_toTopOf="@+id/home"
                tools:src="@drawable/ic_animal_care_24dp" />

            <ImageButton
                android:id="@+id/home"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/greenview"
                android:src="@drawable/ic_home_care_24dp"
                app:layout_constraintBottom_toTopOf="@+id/eye"
                app:layout_constraintStart_toStartOf="@+id/shopping"
                app:layout_constraintTop_toBottomOf="@+id/shopping"
                tools:src="@drawable/ic_home_care_24dp" />

            <ImageButton
                android:id="@+id/geek"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:background="@drawable/greenview"
                android:src="@drawable/ic_geek_24dp"
                app:layout_constraintStart_toStartOf="@+id/self"
                app:layout_constraintTop_toTopOf="@+id/books"
                tools:src="@drawable/ic_geek_24dp" />

            <ImageButton
                android:id="@+id/oral"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:background="@drawable/greenview"
                android:src="@drawable/ic_oral_care_24dp"
                app:layout_constraintStart_toStartOf="@+id/geek"
                app:layout_constraintTop_toTopOf="@+id/animal"
                tools:src="@drawable/ic_oral_care_24dp" />

            <ImageButton
                android:id="@+id/eye"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/greenview"
                android:src="@drawable/ic_eye_care_24dp"
                app:layout_constraintBottom_toTopOf="@+id/all"
                app:layout_constraintStart_toStartOf="@+id/home"
                app:layout_constraintTop_toBottomOf="@+id/home"
                tools:src="@drawable/ic_eye_care_24dp" />

            <ImageButton
                android:id="@+id/fitness"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:background="@drawable/greenview"
                android:src="@drawable/ic_fitness_24dp"
                app:layout_constraintStart_toStartOf="@+id/oral"
                app:layout_constraintTop_toTopOf="@+id/eye"
                tools:src="@drawable/ic_fitness_24dp" />

            <ImageButton
                android:id="@+id/charity"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:background="@drawable/greenview"
                android:src="@drawable/ic_self_care_24"
                app:layout_constraintStart_toStartOf="@+id/geek"
                app:layout_constraintTop_toTopOf="@+id/grooming"
                tools:src="@drawable/ic_self_care_24" />

            <Button
                android:id="@+id/all"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="40dp"
                android:background="@drawable/greenview"
                android:text="View All"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/fitness"
                app:layout_constraintStart_toStartOf="@+id/eye"
                app:layout_constraintTop_toBottomOf="@+id/eye" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gaming"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/gaming"
                app:layout_constraintStart_toStartOf="@+id/gaming"
                app:layout_constraintTop_toBottomOf="@+id/gaming" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shopping"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/shopping"
                app:layout_constraintStart_toStartOf="@+id/shopping"
                app:layout_constraintTop_toBottomOf="@+id/shopping" />

            <TextView
                android:id="@+id/textView16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grooming"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/grooming"
                app:layout_constraintStart_toStartOf="@+id/grooming"
                app:layout_constraintTop_toBottomOf="@+id/grooming" />

            <TextView
                android:id="@+id/textView17"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grooming"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/grooming"
                app:layout_constraintStart_toStartOf="@+id/grooming"
                app:layout_constraintTop_toBottomOf="@+id/grooming" />

            <TextView
                android:id="@+id/textView18"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Child-care"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/child"
                app:layout_constraintStart_toStartOf="@+id/child"
                app:layout_constraintTop_toBottomOf="@+id/child" />

            <TextView
                android:id="@+id/textView14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Books"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/books"
                app:layout_constraintStart_toStartOf="@+id/books"
                app:layout_constraintTop_toBottomOf="@+id/books" />

            <TextView
                android:id="@+id/textView15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Geek"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/geek"
                app:layout_constraintStart_toStartOf="@+id/geek"
                app:layout_constraintTop_toBottomOf="@+id/geek" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Media"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/media"
                app:layout_constraintStart_toStartOf="@+id/media"
                app:layout_constraintTop_toBottomOf="@+id/media" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home-care"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/home"
                app:layout_constraintStart_toStartOf="@+id/home"
                app:layout_constraintTop_toBottomOf="@+id/home" />

            <TextView
                android:id="@+id/textView12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Animal-care"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/animal"
                app:layout_constraintStart_toStartOf="@+id/animal"
                app:layout_constraintTop_toBottomOf="@+id/animal" />

            <TextView
                android:id="@+id/textView13"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oral-care"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/oral"
                app:layout_constraintStart_toStartOf="@+id/oral"
                app:layout_constraintTop_toBottomOf="@+id/oral" />

            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eye-care"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/eye"
                app:layout_constraintStart_toStartOf="@+id/eye"
                app:layout_constraintTop_toBottomOf="@+id/eye" />

            <TextView
                android:id="@+id/textView10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Self-care"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/charity"
                app:layout_constraintStart_toStartOf="@+id/charity"
                app:layout_constraintTop_toBottomOf="@+id/charity" />

            <TextView
                android:id="@+id/textView11"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fitness"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/fitness"
                app:layout_constraintStart_toStartOf="@+id/fitness"
                app:layout_constraintTop_toBottomOf="@+id/fitness" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/food"
                app:layout_constraintStart_toStartOf="@+id/food"
                app:layout_constraintTop_toBottomOf="@+id/food" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fashion"
                android:textColor="@color/colorPrimary"
                app:layout_constraintEnd_toEndOf="@+id/self"
                app:layout_constraintStart_toStartOf="@+id/self"
                app:layout_constraintTop_toBottomOf="@+id/self" />


        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>